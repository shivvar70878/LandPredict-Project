# Application
APP_ENV=production
PORT=8000

# PostgreSQL database. Prefer DATABASE_URL in production.
DATABASE_URL=postgresql://landpredict_user:change-me@127.0.0.1:5432/landpredict

# Optional component variables for platforms that do not provide DATABASE_URL.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=landpredict_user
# DB_PASSWORD=change-me
# DB_NAME=landpredict
# DB_SSLMODE=require

# Comma-separated browser origins. Use the deployed frontend URL in production.
CORS_ORIGINS=https://your-app.example.com