# ==============================================================================
# LandPredict AI: Environment Configuration (.env)
# Ministry of Road Transport & Highways (MoRTH)
# ==============================================================================

# Option 1: Standard Connection URL (recommended for cloud hosting)
# Set this in Render as a secret environment variable. Do not use 127.0.0.1 in production.
# DATABASE_URL=mysql://username:password@your-mysql-host.example.com:3306/landpredict?ssl-mode=REQUIRED

# Option 2: Individual Connection Parameters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=landpredict

# Cloud SSL Configuration (Set to REQUIRED for Aiven / TiDB / Railway / AWS RDS)
MYSQL_SSL=REQUIRED

# Server Configuration
PORT=8000
HOST=0.0.0.0

